# Used automatically by `expo export` / `eas update` (production mode), where it
# takes precedence over .env. Without this file, `eas update` run on a dev
# machine inlined .env's http://localhost:8000 into the published OTA bundle —
# every phone that applied such an update lost ALL backend connectivity
# ("Network request failed" on every API call) until reinstall. Nov 4-13 2026
# OTAs shipped broken this way. Keep this pointing at production.
EXPO_PUBLIC_BACKEND_URL=https://the-program-app.emergent.host
