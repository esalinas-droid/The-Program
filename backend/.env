# backend/.env — PUBLIC / NON-SECRET CONFIG ONLY
# Secrets live in backend/.env.local (gitignored)

# Database (local — no credentials needed)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"

# JWT (non-secret fields only)
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Email
RESEND_FROM_EMAIL=noreply@theprogram.app

# OAuth — Client IDs are public (bundled in the APK; safe to commit)
GOOGLE_CLIENT_ID=992431655499-6a9thk2cdgadtep2347oht3ksa0e494e.apps.googleusercontent.com
APPLE_CLIENT_ID=placeholder_apple_client_id
FACEBOOK_APP_ID=placeholder_facebook_app_id

# CORS
ALLOWED_ORIGINS=*

# Feature flags
BYPASS_IMAGE_CREDITS=true
