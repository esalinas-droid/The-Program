# backend/.env.example — documents required env-var NAMES only.
# Copy to backend/.env and fill in real values. NEVER commit real secrets.
# In production these are injected via Kubernetes, not from this file.

# Database (local — no credentials needed)
MONGO_URL=
DB_NAME=

# JWT (non-secret fields only)
JWT_ALGORITHM=
JWT_EXPIRE_DAYS=

# Email
RESEND_FROM_EMAIL=

# OAuth — Client IDs are public (bundled in the APK; safe to commit)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=

# CORS
ALLOWED_ORIGINS=

# Feature flags
BYPASS_IMAGE_CREDITS=

# Secrets — leave blank here; set real value in backend/.env (gitignored)
EMERGENT_LLM_KEY=
