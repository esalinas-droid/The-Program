# backend/.env.example — documents required env-var NAMES only.
# Copy to backend/.env and fill in real values. NEVER commit real secrets.
# In production these are injected via Kubernetes, not from this file.

# Database (local — no credentials needed)
MONGO_URL=
DB_NAME=

# JWT (non-secret fields only)
JWT_ALGORITHM=
JWT_EXPIRE_DAYS=

# JWT signing secret — REQUIRED. The app refuses to start if this is unset
# (no insecure default). Generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# In production set via Emergent Deployment Secrets.
JWT_SECRET=

# Email
RESEND_FROM_EMAIL=

# OAuth — Client IDs are public (bundled in the APK; safe to commit)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=

# CORS
ALLOWED_ORIGINS=

# Feature flags
BYPASS_IMAGE_CREDITS=

# Secrets — leave blank here; set real value in backend/.env (gitignored)
EMERGENT_LLM_KEY=

# OpenAI — used for RAG embeddings (knowledge-base search)
OPENAI_API_KEY=

# Supabase — vector knowledge base (RAG) + tracker image storage.
# SUPABASE_KEY is the anon key (sufficient for knowledge-base search).
# SUPABASE_SERVICE_ROLE_KEY is required for tracker image UPLOADS; without it
# scanned workout images can't be stored (parsing still works, thumbnail won't).
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin endpoint (GET /api/admin/users) — endpoint is DISABLED unless this is
# set. Generate a strong random value; in production set via Deployment Secrets.
ADMIN_API_SECRET=
